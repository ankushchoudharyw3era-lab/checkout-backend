# Copy this file to .env and fill in real values. NEVER commit .env to git.

# Razorpay (from Razorpay Dashboard > Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Shopify Admin API (from Shopify Admin > Settings > Apps > Develop apps)
SHOPIFY_STORE_DOMAIN=yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxx

PORT=3000
